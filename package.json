{
  "name": "qrdrop",
  "version": "0.2.0",
  "type": "module",
  "description": "Send a file straight from one device to another. A QR code carries the key; the file goes over WebRTC; nothing in between ever holds a readable copy.",
  "license": "MIT",
  "author": "Bevan Stanely",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stan-ely/qrdrop.git"
  },
  "homepage": "https://github.com/stan-ely/qrdrop#readme",
  "bugs": {
    "url": "https://github.com/stan-ely/qrdrop/issues"
  },
  "keywords": [
    "file-transfer",
    "webrtc",
    "p2p",
    "qrcode",
    "end-to-end-encryption",
    "cli"
  ],
  "bin": {
    "qrdrop": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./web": "./src/web/index.js",
    "./node": "./src/node/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "site/dist"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test && node scripts/build-site.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "node scripts/build-site.mjs",
    "start": "node scripts/build-site.mjs --serve",
    "web": "node scripts/build-site.mjs && node src/cli.js web",
    "cli": "node src/cli.js",
    "test:e2e": "npm run build && node e2e/transfer.e2e.mjs",
    "test:e2e:interop": "npm run build && node e2e/interop.e2e.mjs"
  },
  "dependencies": {
    "@trystero-p2p/nostr": "0.25.3",
    "@trystero-p2p/torrent": "0.25.3",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "optionalDependencies": {
    "node-datachannel": "0.33.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.25.0",
    "mermaid": "^11.17.2",
    "playwright": "^1.61.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
