{
  // The browser project: everything that ships to a page.
  //
  // src/core/ and src/transport/ appear here AND in tsconfig.node.json. That
  // duplication is the point -- they are the isomorphic half of the package,
  // and checking them under both sets of globals is what enforces the claim.
  // A `Buffer.from` in core passes the Node project and fails here.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    // Empty on purpose. Without it, every @types package under node_modules is
    // included automatically -- including @types/node, which is installed for
    // the test project. That would put Buffer, process, and the Node globals
    // in scope for code that runs in a browser and has none of them.
    "types": []
  },
  "include": [
    "src/core/**/*.js",
    "src/transport/**/*.js",
    "src/web/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "site/dist", "dist"]
}
