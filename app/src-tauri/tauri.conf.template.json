{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qrdrop",
  "identifier": "com.stan-ely.qrdrop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "qrdrop",
        "width": 480,
        "height": 720
      }
    ],
    "security": {
      "csp": "__CSP__"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["qrdrop"]
      },
      "mobile": [
        { "host": "share.stan-ely.com", "pathPrefix": ["/"] }
      ]
    }
  }
}
