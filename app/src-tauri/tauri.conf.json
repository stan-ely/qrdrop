{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "qrdrop",
  "identifier": "com.stan-ely.qrdrop",
  "build": {
    "frontendDist": "../spike"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "qrdrop -- Phase 0 capability spike",
        "width": 480,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' wss://nos.lol; script-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' blob: mediastream:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
