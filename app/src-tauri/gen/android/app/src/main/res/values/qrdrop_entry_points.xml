<?xml version="1.0" encoding="utf-8"?>
<!--
  Labels for the launcher shortcuts and the Quick Settings tile.

  A SEPARATE FILE FROM strings.xml, and that is the point of it. strings.xml is
  generated by Tauri (app_name, main_activity_title), so adding to it would put
  a hand edit inside a file a re-init rewrites, next to two values that must
  keep coming from the generator. This file is one Tauri has never heard of, so
  it survives untouched and there is nothing to merge. Android does not care
  which file in res/values a string lives in.

  Android requires shortcut labels to be resource references rather than
  literals, which is why these exist at all. The short label is what a launcher
  shows under the icon and is clipped hard; the long one appears in the
  long-press menu where there is room for a verb.
-->
<resources>
    <string name="shortcut_scan_short">Scan</string>
    <string name="shortcut_scan_long">Scan a code</string>
    <string name="shortcut_send_short">Send</string>
    <string name="shortcut_send_long">Send a file</string>
    <!-- The tile sits in a grid of one-or-two-word labels, so it names the
         app rather than the action: "Receive a file" wraps and truncates, and
         a person pulling down the shade is looking for qrdrop, not for a verb. -->
    <string name="tile_label">qrdrop</string>
</resources>
