<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      The QR scanner and Beam both call getUserMedia, and the Android System
      WebView cannot open the camera unless the app itself holds this. There
      is no tauri.conf.json field that emits it, which is why gen/android is
      committed rather than regenerated (see CLAUDE.md): a re-init would drop
      this line and the scanner would fail with nothing to diff.

      Declaring it is necessary but, on Android 6+, not sufficient. CAMERA is
      a "dangerous" permission and also needs a runtime request. Whether wry
      raises that from the WebView's own permission request is the open
      question recorded in app/CAPABILITIES.md.

      required="false" on the feature is deliberate: a device with no camera
      can still send a file and still use the network transfer, and the UI
      already declines the camera paths on its own (view.js NO_CAMERA_BEAM).
      Marking it required would make the app uninstallable there to protect a
      path that already refuses itself.

      Note for editors: this repository's prose style uses a double hyphen as
      an em dash, and XML forbids that sequence inside a comment. Gradle
      reports it only as "Error parsing AndroidManifest.xml", so keep the
      punctuation plain in here.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.qrdrop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!--
              LAUNCHER SHORTCUTS. Long press the icon, land on a screen. This
              line is a hand edit; res/xml/shortcuts.xml, which it points at,
              is a file Tauri does not generate and so is merely added. Both
              are in CLAUDE.md's list, because a re-init dropping this line
              would leave that file orphaned with no error anywhere: the
              shortcuts would simply stop appearing.

              The chain from a shortcut to the UI is the share sheet's chain
              with an action string in place of a file. See shortcuts.xml.
            -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!--
              THE SHARE SHEET. This is the third hand edit inside gen/, after
              the CAMERA permission above and the adaptive icon background in
              res/values/ic_launcher_background.xml. CLAUDE.md lists all
              three, and that list is the only thing standing between a
              `tauri android init` and losing them with nothing to diff.

              There is no tauri.conf.json field that emits an ACTION_SEND
              filter, which is the same reason the CAMERA permission is a hand
              edit: the delta can only live here.

              mimeType */* because qrdrop sends any file, and narrowing it to
              image/* would take the app out of the share sheet for exactly
              the documents it is best at moving.

              SEND_MULTIPLE is declared even though only one file is taken.
              qrdrop moves one file at a time, and the alternative was to
              leave it out. But an app that vanishes from the share sheet
              the moment a second photo is selected reads as broken, where
              taking the first and naming it on the send screen says plainly
              what happened. MainActivity.kt's firstStream does that.

              The receiving end is MainActivity.stashSharedFile, then
              src/share.rs, then app/src/main.js. Adding this filter without
              that chain would put qrdrop in the share sheet and have it do
              nothing, which is worse than not being there at all.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>

            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter android:autoVerify="true" >
                <action android:name="android.intent.action.VIEW" />
                <!-- ChromeOS ARC++ uses a different action for deep links -->
                <action android:name="org.chromium.arc.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="share.stan-ely.com" />
                
                
                <data android:pathPrefix="/" />
                
            </intent-filter>
            <!-- DEEP LINK PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <!--
          THE QUICK SETTINGS TILE. Receiving starts with a code already on
          someone else's screen and a person waiting, so every tap before the
          camera opens is spent while they wait. From the shade it is one pull
          and one tap, without leaving whatever app you were in.

          android:permission is not optional and not a precaution: a tile
          service that does not require BIND_QUICK_SETTINGS_TILE is one any
          app could bind to, and Android will not list it. exported must be
          true for the same reason, since the system binds it from outside.

          It reaches the web layer through the same extra, the same
          MainActivity.stashLaunchAction and the same cache file handoff the
          launcher shortcuts use. One mechanism for both, so there is one
          thing to keep in step with a chain that already has four links.

          Note for editors: this repository's prose style uses a double hyphen
          as an em dash, and XML forbids that sequence inside a comment.
          Gradle reports it only as "Error parsing AndroidManifest.xml".
        -->
        <service
            android:name=".QrdropTileService"
            android:exported="true"
            android:icon="@drawable/ic_qrdrop_scan"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
