{
  // Settings shared by the three projects. Not a project itself -- it has no
  // `include`, so running tsc against it directly checks nothing.
  //
  // There are three projects because there are three runtimes. src/core/ and
  // src/transport/ must run in both a browser and Node, so they are checked
  // twice under two different sets of globals -- that double-check is the only
  // thing standing between "isomorphic" and "isomorphic until someone reaches
  // for Buffer". src/web/ needs the DOM; src/node/ and the tests need Node.
  //
  // A single combined project would make Node globals visible to browser code,
  // and a stray `Buffer.from` in a file served to users would typecheck
  // cleanly right up until it threw.
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,

    // The floor is "what the browsers we target actually have". P-256 ECDH,
    // BigUint64 DataView access, and top-level await are all in use already.
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // Our own code is checked strictly; the dependency graph under
    // node_modules is not ours to fix.
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  }
}
